[
  {
    "id": "morning-01",
    "text": "锲而不舍，金石可镂。",
    "author": "荀子",
    "authorId": "xunzi",
    "source": "《荀子·劝学》",
    "sourceUrl": "https://ctext.org/xunzi/quan-xue/zh",
    "background": "backgrounds/dawn.jpg",
    "portrait": null,
    "font": "kai"
  },
  {
    "id": "morning-02",
    "text": "不积跬步，无以至千里；不积小流，无以成江海。",
    "author": "荀子",
    "authorId": "xunzi",
    "source": "《荀子·劝学》",
    "sourceUrl": "https://ctext.org/xunzi/quan-xue/zh",
    "background": "backgrounds/mountains.jpg",
    "portrait": null,
    "font": "xingkai"
  },
  {
    "id": "morning-03",
    "text": "骐骥一跃，不能十步；驽马十驾，功在不舍。",
    "author": "荀子",
    "authorId": "xunzi",
    "source": "《荀子·劝学》",
    "sourceUrl": "https://ctext.org/xunzi/quan-xue/zh",
    "background": "backgrounds/forest.jpg",
    "portrait": null,
    "font": "li"
  },
  {
    "id": "morning-04",
    "text": "学不可以已。",
    "author": "荀子",
    "authorId": "xunzi",
    "source": "《荀子·劝学》",
    "sourceUrl": "https://ctext.org/xunzi/quan-xue/zh",
    "background": "backgrounds/lake.jpg",
    "portrait": null,
    "font": "kai"
  },
  {
    "id": "morning-05",
    "text": "学而时习之，不亦说乎？",
    "author": "孔子",
    "authorId": "confucius",
    "source": "《论语·学而》",
    "sourceUrl": "https://ctext.org/analects/xue-er/zh",
    "background": "backgrounds/sunlight.jpg",
    "portrait": "portraits/confucius.jpg",
    "font": "xingkai"
  },
  {
    "id": "morning-06",
    "text": "譬如为山，未成一篑，止，吾止也。",
    "author": "孔子",
    "authorId": "confucius",
    "source": "《论语·子罕》",
    "sourceUrl": "https://ctext.org/analects/zi-han/zh",
    "background": "backgrounds/mist.jpg",
    "portrait": "portraits/confucius.jpg",
    "font": "li"
  },
  {
    "id": "morning-07",
    "text": "岁寒，然后知松柏之后凋也。",
    "author": "孔子",
    "authorId": "confucius",
    "source": "《论语·子罕》",
    "sourceUrl": "https://ctext.org/analects/zi-han/zh",
    "background": "backgrounds/dawn.jpg",
    "portrait": "portraits/confucius.jpg",
    "font": "kai"
  },
  {
    "id": "morning-08",
    "text": "千里之行，始于足下。",
    "author": "老子",
    "authorId": "laozi",
    "source": "《道德经》第六十四章",
    "sourceUrl": "https://ctext.org/dao-de-jing/zh",
    "background": "backgrounds/mountains.jpg",
    "portrait": null,
    "font": "xingkai"
  },
  {
    "id": "morning-09",
    "text": "为之于未有，治之于未乱。",
    "author": "老子",
    "authorId": "laozi",
    "source": "《道德经》第六十四章",
    "sourceUrl": "https://ctext.org/dao-de-jing/zh",
    "background": "backgrounds/forest.jpg",
    "portrait": null,
    "font": "li"
  },
  {
    "id": "morning-10",
    "text": "慎终如始，则无败事。",
    "author": "老子",
    "authorId": "laozi",
    "source": "《道德经》第六十四章",
    "sourceUrl": "https://ctext.org/dao-de-jing/zh",
    "background": "backgrounds/lake.jpg",
    "portrait": null,
    "font": "kai"
  },
  {
    "id": "morning-11",
    "text": "有为者辟若掘井，掘井九轫而不及泉，犹为弃井也。",
    "author": "孟子",
    "authorId": "mencius",
    "source": "《孟子·尽心上》",
    "sourceUrl": "https://ctext.org/mengzi/jin-xin-i/zh",
    "background": "backgrounds/sunlight.jpg",
    "portrait": "portraits/mencius.jpg",
    "font": "xingkai"
  },
  {
    "id": "morning-12",
    "text": "业精于勤，荒于嬉；行成于思，毁于随。",
    "author": "韩愈",
    "authorId": "hanyu",
    "source": "《进学解》",
    "sourceUrl": "https://zh.wikisource.org/wiki/進學解",
    "background": "backgrounds/mist.jpg",
    "portrait": "portraits/hanyu.jpg",
    "font": "li"
  },
  {
    "id": "morning-13",
    "text": "知是行之始，行是知之成。",
    "author": "王阳明",
    "authorId": "wangyangming",
    "source": "《传习录》上",
    "sourceUrl": "https://zh.wikisource.org/wiki/傳習錄/卷上",
    "background": "backgrounds/dawn.jpg",
    "portrait": "portraits/wangyangming.jpg",
    "font": "kai"
  },
  {
    "id": "morning-14",
    "text": "人须在事上磨，方立得住，方能静亦定，动亦定。",
    "author": "王阳明",
    "authorId": "wangyangming",
    "source": "《传习录》上",
    "sourceUrl": "https://zh.wikisource.org/wiki/傳習錄/卷上",
    "background": "backgrounds/mountains.jpg",
    "portrait": "portraits/wangyangming.jpg",
    "font": "xingkai"
  },
  {
    "id": "morning-15",
    "text": "古之立大事者，不惟有超世之才，亦必有坚忍不拔之志。",
    "author": "苏轼",
    "authorId": "sushi",
    "source": "《晁错论》",
    "sourceUrl": "https://zh.wikisource.org/wiki/晁錯論",
    "background": "backgrounds/forest.jpg",
    "portrait": "portraits/sushi.jpg",
    "font": "li"
  },
  {
    "id": "morning-16",
    "text": "博观而约取，厚积而薄发。",
    "author": "苏轼",
    "authorId": "sushi",
    "source": "《稼说送张琥》",
    "sourceUrl": "https://zh.wikisource.org/wiki/稼說送張琥",
    "background": "backgrounds/lake.jpg",
    "portrait": "portraits/sushi.jpg",
    "font": "kai"
  },
  {
    "id": "morning-17",
    "text": "纸上得来终觉浅，绝知此事要躬行。",
    "author": "陆游",
    "authorId": "luyou",
    "source": "《冬夜读书示子聿》",
    "sourceUrl": "https://zh.wikisource.org/wiki/冬夜讀書示子聿",
    "background": "backgrounds/sunlight.jpg",
    "portrait": "portraits/luyou.jpg",
    "font": "xingkai"
  },
  {
    "id": "morning-18",
    "text": "千淘万漉虽辛苦，吹尽狂沙始到金。",
    "author": "刘禹锡",
    "authorId": "liuyuxi",
    "source": "《浪淘沙九首》其八",
    "sourceUrl": "https://zh.wikisource.org/wiki/浪淘沙九首",
    "background": "backgrounds/mist.jpg",
    "portrait": "portraits/liuyuxi.jpg",
    "font": "li"
  },
  {
    "id": "morning-19",
    "text": "千磨万击还坚劲，任尔东西南北风。",
    "author": "郑燮",
    "authorId": "zhengxie",
    "source": "《竹石》",
    "sourceUrl": "https://zh.wikisource.org/wiki/竹石",
    "background": "backgrounds/dawn.jpg",
    "portrait": "portraits/zhengxie.png",
    "font": "kai"
  },
  {
    "id": "morning-20",
    "text": "问渠那得清如许？为有源头活水来。",
    "author": "朱熹",
    "authorId": "zhuxi",
    "source": "《观书有感》其一",
    "sourceUrl": "https://zh.wikisource.org/wiki/觀書有感",
    "background": "backgrounds/mountains.jpg",
    "portrait": "portraits/zhuxi.jpg",
    "font": "xingkai"
  },
  {
    "id": "morning-21",
    "text": "学问之道无穷，而总以有恒为主。",
    "author": "曾国藩",
    "authorId": "zengguofan",
    "source": "《曾国藩家书》",
    "sourceUrl": "https://ctext.org/wiki.pl?chapter=684526&if=gb&remap=gb",
    "background": "backgrounds/forest.jpg",
    "portrait": "portraits/zengguofan.jpg",
    "font": "li"
  },
  {
    "id": "morning-22",
    "text": "长风破浪会有时，直挂云帆济沧海。",
    "author": "李白",
    "authorId": "libai",
    "source": "《行路难》其一",
    "sourceUrl": "https://zh.wikisource.org/wiki/行路難_(李白)",
    "background": "backgrounds/lake.jpg",
    "portrait": "portraits/libai.jpg",
    "font": "kai"
  },
  {
    "id": "morning-23",
    "text": "其实地上本没有路，走的人多了，也便成了路。",
    "author": "鲁迅",
    "authorId": "luxun",
    "source": "《故乡》",
    "sourceUrl": "https://zh.wikisource.org/wiki/故鄉_(魯迅)",
    "background": "backgrounds/sunlight.jpg",
    "portrait": "portraits/luxun.jpg",
    "font": "xingkai"
  },
  {
    "id": "morning-24",
    "text": "勤能补拙是良训，一分辛苦一分才。",
    "author": "华罗庚",
    "authorId": "hualuogeng",
    "source": "治学名言；中国科学院纪念文章",
    "sourceUrl": "https://www.cas.cn/zt/rwzt/JNHLGSS25ZN/HLG25HY/201006/t20100610_2879344.html",
    "background": "backgrounds/mist.jpg",
    "portrait": "portraits/hualuogeng.jpg",
    "font": "li"
  },
  {
    "id": "morning-25",
    "text": "及时当勉励，岁月不待人。",
    "author": "陶渊明",
    "authorId": "taoyuanming",
    "source": "《杂诗》其一",
    "sourceUrl": "https://zh.wikisource.org/wiki/雜詩_(陶潛)",
    "background": "backgrounds/dawn.jpg",
    "portrait": "portraits/taoyuanming.jpg",
    "font": "kai"
  },
  {
    "id": "morning-26",
    "text": "三更灯火五更鸡，正是男儿读书时。",
    "author": "颜真卿",
    "authorId": "yanzhenqing",
    "source": "《劝学》",
    "sourceUrl": "https://zh.wikisource.org/wiki/勸學_(顏真卿)",
    "background": "backgrounds/mountains.jpg",
    "portrait": "portraits/yanzhenqing.jpg",
    "font": "xingkai"
  },
  {
    "id": "morning-27",
    "text": "做得好，胜过说得好。",
    "author": "本杰明·富兰克林",
    "authorId": "franklin",
    "source": "《穷理查年鉴》",
    "sourceUrl": "https://www.gutenberg.org/files/36151/36151-h/36151-h.htm",
    "original": "Well done is better than well said.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/forest.jpg",
    "portrait": "portraits/franklin.jpg",
    "font": "serif"
  },
  {
    "id": "morning-28",
    "text": "小小的斧击，也能伐倒参天大树。",
    "author": "本杰明·富兰克林",
    "authorId": "franklin",
    "source": "《穷理查年鉴》",
    "sourceUrl": "https://americanliterature.com/author/benjamin-franklin/essay/poor-richards-almanack",
    "original": "Little strokes fell great oaks.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/lake.jpg",
    "portrait": "portraits/franklin.jpg",
    "font": "hand"
  },
  {
    "id": "morning-29",
    "text": "在新习惯牢牢扎根之前，别让例外发生。",
    "author": "威廉·詹姆斯",
    "authorId": "james",
    "source": "《与教师谈心理学》·习惯",
    "sourceUrl": "https://www.gutenberg.org/files/16287/16287-h/16287-h.htm",
    "original": "Never suffer an exception to occur till the new habit is securely rooted in your life.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/sunlight.jpg",
    "portrait": "portraits/james.jpg",
    "font": "slab"
  },
  {
    "id": "morning-30",
    "text": "抓住最早的机会，把你的每一个决心付诸行动。",
    "author": "威廉·詹姆斯",
    "authorId": "james",
    "source": "《与教师谈心理学》·习惯",
    "sourceUrl": "https://www.gutenberg.org/files/16287/16287-h/16287-h.htm",
    "original": "Seize the very first possible opportunity to act on every resolution you make.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/mist.jpg",
    "portrait": "portraits/james.jpg",
    "font": "serif"
  },
  {
    "id": "morning-31",
    "text": "没有热忱，就成就不了伟大的事业。",
    "author": "拉尔夫·沃尔多·爱默生",
    "authorId": "emerson",
    "source": "《随笔集》·圆",
    "sourceUrl": "https://www.gutenberg.org/files/2944/2944-h/2944-h.htm",
    "original": "Nothing great was ever achieved without enthusiasm.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/dawn.jpg",
    "portrait": null,
    "font": "hand"
  },
  {
    "id": "morning-32",
    "text": "去做你的工作，我便能认识你。",
    "author": "拉尔夫·沃尔多·爱默生",
    "authorId": "emerson",
    "source": "《随笔集》·自立",
    "sourceUrl": "https://www.gutenberg.org/cache/epub/16643/pg16643-images.html",
    "original": "But do your work, and I shall know you.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/mountains.jpg",
    "portrait": null,
    "font": "slab"
  },
  {
    "id": "morning-33",
    "text": "如果你已在空中建起楼阁，现在就为它们打下地基。",
    "author": "亨利·戴维·梭罗",
    "authorId": "thoreau",
    "source": "《瓦尔登湖》·结束语（节译）",
    "sourceUrl": "https://www.gutenberg.org/files/205/205-h/205-h.htm",
    "original": "If you have built castles in the air, your work need not be lost; that is where they should be. Now put the foundations under them.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/forest.jpg",
    "portrait": null,
    "font": "serif"
  },
  {
    "id": "morning-34",
    "text": "人能以自觉的努力提升自己的生活，没有比这更令人鼓舞的事实。",
    "author": "亨利·戴维·梭罗",
    "authorId": "thoreau",
    "source": "《瓦尔登湖》·我生活的地方；我为何生活",
    "sourceUrl": "https://www.gutenberg.org/files/205/205-h/205-h.htm",
    "original": "I know of no more encouraging fact than the unquestionable ability of man to elevate his life by a conscious endeavour.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/lake.jpg",
    "portrait": null,
    "font": "hand"
  },
  {
    "id": "morning-35",
    "text": "当我们一再推迟，生命正匆匆流逝。",
    "author": "塞涅卡",
    "authorId": "seneca",
    "source": "《致卢基利乌斯书信集》第一封",
    "sourceUrl": "https://en.wikisource.org/wiki/Moral_letters_to_Lucilius/Letter_1",
    "original": "While we are postponing, life speeds by.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/sunlight.jpg",
    "portrait": "portraits/seneca.jpg",
    "font": "slab"
  },
  {
    "id": "morning-36",
    "text": "并非因为事情困难，我们才不敢；而是因为不敢，事情才困难。",
    "author": "塞涅卡",
    "authorId": "seneca",
    "source": "《致卢基利乌斯书信集》第一〇四封",
    "sourceUrl": "https://en.wikisource.org/wiki/Moral_letters_to_Lucilius/Letter_104",
    "original": "It is not because things are difficult that we do not dare; it is because we do not dare that they are difficult.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/mist.jpg",
    "portrait": "portraits/seneca.jpg",
    "font": "serif"
  },
  {
    "id": "morning-37",
    "text": "清晨不愿起身时，告诉自己：我要起来，去做一个人该做的事。",
    "author": "马可·奥勒留",
    "authorId": "marcus",
    "source": "《沉思录》卷五·第一则",
    "sourceUrl": "https://www.gutenberg.org/files/6920/6920-h/6920-h.htm",
    "original": "In the morning when thou risest unwillingly, let this thought be present,—I am rising to the work of a human being.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/dawn.jpg",
    "portrait": "portraits/marcus.jpg",
    "font": "hand"
  },
  {
    "id": "morning-38",
    "text": "别再空谈一个好人应该是什么样，去成为那样的人。",
    "author": "马可·奥勒留",
    "authorId": "marcus",
    "source": "《沉思录》卷十·第十六则",
    "sourceUrl": "https://www.gutenberg.org/files/6920/6920-h/6920-h.htm",
    "original": "No longer talk at all about the kind of man that a good man ought to be, but be such.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/mountains.jpg",
    "portrait": "portraits/marcus.jpg",
    "font": "slab"
  },
  {
    "id": "morning-39",
    "text": "没有伟大的事物是在一瞬间成就的。",
    "author": "爱比克泰德",
    "authorId": "epictetus",
    "source": "《论说集》第一卷·第十五章",
    "sourceUrl": "https://classics.mit.edu/Epictetus/discourses.html",
    "original": "No great thing is created suddenly.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/forest.jpg",
    "portrait": null,
    "font": "serif"
  },
  {
    "id": "morning-40",
    "text": "想善于阅读，就去读；想善于写作，就去写。",
    "author": "爱比克泰德",
    "authorId": "epictetus",
    "source": "《论说集》第二卷·第十八章",
    "sourceUrl": "https://classics.mit.edu/Epictetus/discourses.html",
    "original": "If you would be a good reader, read; if a writer, write.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/lake.jpg",
    "portrait": null,
    "font": "hand"
  },
  {
    "id": "morning-41",
    "text": "不断成就，不断追求；学会劳作，也学会等候。",
    "author": "亨利·沃兹沃斯·朗费罗",
    "authorId": "longfellow",
    "source": "《人生颂》（节译）",
    "sourceUrl": "https://www.gutenberg.org/files/1365/1365-h/1365-h.htm",
    "original": "Still achieving, still pursuing, learn to labor and to wait.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/sunlight.jpg",
    "portrait": null,
    "font": "slab"
  },
  {
    "id": "morning-42",
    "text": "虽然世界充满苦难，也充满着战胜苦难的力量。",
    "author": "海伦·凯勒",
    "authorId": "keller",
    "source": "《乐观》（节译）",
    "sourceUrl": "https://www.gutenberg.org/files/31622/31622-h/31622-h.htm",
    "original": "Although the world is full of suffering, it is full also of the overcoming of it.",
    "translation": "项目自译（含节译），原文见来源",
    "background": "backgrounds/mist.jpg",
    "portrait": "portraits/keller.jpg",
    "font": "serif"
  }
]
